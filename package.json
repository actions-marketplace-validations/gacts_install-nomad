{
  "name": "install-nomad",
  "description": "Installs nomad binary file into your actions workflow",
  "main": "src/index.js",
  "scripts": {
    "lint": "eslint --config package.json './src/**/*.js'",
    "build": "ncc build src/index.js -o dist --minify --no-cache"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gacts/install-nomad.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "Nomad"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gacts/install-nomad/issues"
  },
  "homepage": "https://github.com/gacts/install-nomad#readme",
  "dependencies": {
    "@actions/cache": "^5.0.1",
    "@actions/core": "^2.0.1",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^6.0.1",
    "@actions/io": "^2.0.0",
    "@actions/tool-cache": "^2.0.2"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "eslint": "^8.57.1"
  },
  "eslintConfig": {
    "env": {
      "commonjs": true,
      "es6": true,
      "node": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 2018
    },
    "rules": {}
  }
}
